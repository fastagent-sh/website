{
  "name": "@fastagent-sh/website",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "sync:docs": "node scripts/sync-fastagent-docs.mjs",
    "og": "node scripts/render-og.mjs",
    "predev": "npm run sync:docs && npm run tokens",
    "dev": "astro dev",
    "precheck": "npm run sync:docs && npm run tokens",
    "check": "node scripts/check-site.mjs && astro check",
    "prebuild": "npm run sync:docs && npm run tokens",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "npm run build && wrangler deploy",
    "deploy:www": "wrangler deploy --config wrangler.www.jsonc",
    "tokens": "node scripts/build-tokens.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.4",
    "@plausible-analytics/tracker": "^0.4.5",
    "astro": "^7.1.3",
    "sharp": "^0.35.3",
    "starlight-links-validator": "^0.25.2",
    "starlight-llms-txt": "^0.11.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "typescript": "^6.0.3",
    "wrangler": "^4.114.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
