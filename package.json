{
  "name": "@fastagent-sh/website",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "sync:docs": "node scripts/sync-fastagent-docs.mjs",
    "og": "node scripts/render-og.mjs",
    "predev": "npm run sync:docs && npm run tokens",
    "dev": "astro dev",
    "precheck": "npm run sync:docs && npm run tokens",
    "check": "node scripts/check-site.mjs && astro check",
    "prebuild": "npm run sync:docs && npm run tokens",
    "build": "astro build",
    "postbuild": "node scripts/check-agent-surfaces.mjs",
    "preview": "astro preview",
    "deploy": "npm run build && wrangler deploy",
    "deploy:www": "wrangler deploy --config wrangler.www.jsonc",
    "tokens": "node scripts/build-tokens.mjs"
  },
  "dependencies": {
    "@cloudflare/nimbus-docs": "^0.11.0",
    "@iconify-json/ph": "^1.2.2",
    "@plausible-analytics/tracker": "^0.4.6",
    "astro": "^7.1.4",
    "astro-icon": "^1.1.5",
    "clsx": "^2.1.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.127.1"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
