# Agent discovery (RFC 8288): point agents at the markdown corpus, the
# skills index, and the docs from the pages they actually land on.
# Each section also has its own index, so a page names the nearest one.
/
  Link: </llms.txt>; rel="llms-txt", </.well-known/agent-skills/index.json>; rel="agent-skills", </docs/>; rel="service-doc"
/docs/*
  Link: </docs/llms.txt>; rel="llms-txt", </llms.txt>; rel="index", </.well-known/agent-skills/index.json>; rel="agent-skills"
/blog/*
  Link: </blog/llms.txt>; rel="llms-txt", </llms.txt>; rel="index", </.well-known/agent-skills/index.json>; rel="agent-skills"
